rules_version = '2';
// Photos: only vault accounts can upload or delete; images only, max 20 MB each.
// Keep the email list identical to firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.active == true;
    }
    function isVaultUser() {
      return request.auth != null
        && (request.auth.token.email in ['paulckinckay@gmail.com', 'kohlindersjohn@gmail.com'] || isMember());
    }
    match /photos/{file} {
      allow read: if isVaultUser();
      allow create, update: if isVaultUser()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isVaultUser();
    }
  }
}
